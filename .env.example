# Salin file ini jadi ".env" untuk development lokal (jangan commit .env ke GitHub)
# Nilainya diambil dari file JSON kredensial service account yang kamu download.

GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-bot@nama-project.iam.gserviceaccount.com

# Ambil dari field "private_key" di file JSON. Tetap dalam satu baris dengan \n literal.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_KEY_DISINI\n-----END PRIVATE KEY-----\n"

# ID sheet, diambil dari URL: docs.google.com/spreadsheets/d/INI_ID_NYA/edit
GOOGLE_SHEET_ID=
